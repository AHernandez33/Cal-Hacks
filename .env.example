# Copy to .env; never commit actual credentials. Uvicorn loads this with --env-file .env.
FRONTEND_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
SQLITE_DB_PATH=.local/vigiloforge.db
# Optional administrator setup password for remote deployment. Customer logins use private workspace keys.
VIGILO_API_TOKEN=
# Optional hosted CREAO agent configured with a text input named prompt.
creao_api_key=
creao_app_id=
# Optional; defaults to the interpreter running the API.
FETCH_PYTHON=
# Local-only demo seed is used when absent. Use a private seed for deployed identities.
FETCH_AGENT_SEED=
FETCH_MAILBOX=false
# Normally auto-derived from FETCH_AGENT_SEED. Leave unset for local agent.
fetch_agent_address=
# Direct PostgreSQL credential; set securely on the backend, never in NEXT_PUBLIC_*.
TIGER_DATABASE_URL=

# Local receiver by default. A remote receiver must use HTTPS and its actual agent address.
FETCH_AGENT_ENDPOINT=http://127.0.0.1:8001/submit

# Nine hosted specialists; values stay on the backend.
CREAO_API_VERSION=v1
VIGILO_REQUIRE_EMAIL=false
CREAO_COORDINATOR_APP_ID=
CREAO_COORDINATOR_API_KEY=
CREAO_CROP_INVESTIGATOR_APP_ID=
CREAO_CROP_INVESTIGATOR_API_KEY=
CREAO_LEAF_ANALYST_APP_ID=
CREAO_LEAF_ANALYST_API_KEY=
CREAO_REFERENCE_RETRIEVER_APP_ID=
CREAO_REFERENCE_RETRIEVER_API_KEY=
CREAO_RESPONSE_ADVISOR_APP_ID=
CREAO_RESPONSE_ADVISOR_API_KEY=
CREAO_TREND_ANALYST_APP_ID=
CREAO_TREND_ANALYST_API_KEY=
CREAO_PRIVACY_REVIEWER_APP_ID=
CREAO_PRIVACY_REVIEWER_API_KEY=
CREAO_TELEMETRY_ANALYST_APP_ID=
CREAO_TELEMETRY_ANALYST_API_KEY=
CREAO_VISITOR_GUIDE_APP_ID=
CREAO_VISITOR_GUIDE_API_KEY=
